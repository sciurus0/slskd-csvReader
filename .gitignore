# macOS
.DS_Store
/checkpoint.pkl
/checkpoint.json
/logs
/data/*
!/data/.gitkeep
!/data/exports/
!/data/exports/.gitkeep
# Secrets and local config (never commit)
/api.txt
/config.ini
.env
.env.*
!.env.example
spotify_tokens.json
tokens.json

# Local IDE / agent config and planning (not tracked)
.cursor/
PROJECT_PLAN.md

# Deploy staging / vendored NAS wheels (regenerated by deploy script)
.deploy-csvreader/
docker/wheels/*
!docker/wheels/.gitignore

# CSV pipeline data (exports, queues, reports — not tracked)
*.csv
!fixtures/**/*.csv

# Cross-run merge watermarks (ledger is *.csv)
merge_state.json

# Runtime logs (fixtures use committed .txt excerpts)
*.log

# Python bytecode (keep repo to source only)
__pycache__/
*.py[cod]
*$py.class
